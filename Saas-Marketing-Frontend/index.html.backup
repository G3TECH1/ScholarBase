      <a class="navbar-brand d-flex align-items-center" href="index.html" aria-label="ScholarBase home">
        <img src="https://img.icons8.com/ios-filled/40/ffffff/graduation-cap.png" alt="ScholarBase Logo" class="me-2">
        <span class="fw-bold fs-4">ScholarBase</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
        <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
