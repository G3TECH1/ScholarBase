<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ScholarBase | Modern Cloud School Management</title>
  <meta name="description" content="ScholarBase by G3Tech: Next-generation cloud-native school management platform for progressive schools. Secure, fast, and easy to use.">
  <link rel="icon" href="https://img.icons8.com/ios-filled/50/0f172a/graduation-cap.png" type="image/png">
