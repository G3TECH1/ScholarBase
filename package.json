{
  "name": "scholarbase-desktop",
  "version": "1.0.0",
  "description": "ScholarBase offline-first desktop school management system",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish=never",
    "build-python": "echo 'Python build is handled by CI via PyInstaller'"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "ejs": "^6.0.1",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "flash-message": "^2.0.1",
    "mongoose": "^9.6.3",
    "multer": "^2.3.0",
    "pug": "^3.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.scholarbase.desktop",
    "files": [
      "config/**",
      "controller/**",
      "model/**",
      "public/**",
      "routes/**",
      "utils/**",
      "views/**",
      "app.js",
      "electron-main.js",
      "package.json"
    ],
    "directories": { "buildResources": "build" },
    "extraResources": [
      {
        "from": "python_dist/",
        "to": "python_backend/",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "ScholarBase",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": { "target": "dmg" },
    "linux": { "target": ["AppImage", "deb"] }
  },
  "author": "",
  "license": "MIT"
}
