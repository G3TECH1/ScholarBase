# Shared app settings
NODE_ENV=production
HOST=0.0.0.0
PORT=2000
SESSION_SECRET=change-me-to-a-long-random-secret

# Python database service settings
MZ_APP_MODE=web
MZ_DB_HOST=127.0.0.1
MZ_DB_PORT=31109
MZ_DATA_ROOT=/var/lib/scholarbase
MZ_WEB_DATA_ROOT=/var/lib/scholarbase
MZ_DB_FILE=database_dump.json
MZ_GRADUATED_FILE=graduated_students.json

# Optional: if running a separate daemon on another host
# MZ_DB_HOST=10.0.0.12
# MZ_DB_PORT=31109
